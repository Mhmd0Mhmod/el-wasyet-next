# 🌍 PUBLIC Environment Variables (safe to commit)
# These are visible in the browser and should not contain sensitive data
NEXT_PUBLIC_API_BASE_URL=https://your-api-url.com/api
NEXT_PUBLIC_STORAGE_BASE_URL=https://your-storage-url.com
NEXT_PUBLIC_API_PAGE_SIZE= your-default-page-size-here

# 🔒 PRIVATE Environment Variables (DO NOT commit actual values!)
# Copy this file to .env.local and fill in your actual values
# These are server-side only and not exposed to the browser

# NextAuth configuration
NEXTAUTH_SECRET=your-super-secret-string-here
NEXTAUTH_URL= https://your-app-url-here
AUTH_TRUST_HOST= add-your-trust-host-setting-here
HOST_URL= https://your-app-url-here

# 📝 Notes:
# - Copy this file to .env.local for local development
# - Never commit .env.local to git (it's in .gitignore)